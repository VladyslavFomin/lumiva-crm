+  // ===== СЕГМЕНТЫ =====
+  private mapSegmentFilters(entity: MarketingSegment) {
+    return {
+      statuses: entity.leadStatuses ?? [],
+      sources: entity.source ? [entity.source] : [],
+      countries: entity.country ? [entity.country] : [],
+      managers: entity.manager ? [entity.manager] : [],
+      createdFrom: entity.createdFrom ?? undefined,
+      createdTo: entity.createdTo ?? undefined,
+    };
+  }
+
+  async getSegmentsForTenant(tenantId: string): Promise<any[]> {
+    const segments = await this.segmentRepo.find({
+      where: { tenantId },
+      order: { createdAt: 'DESC' },
+    });
+
+    return segments.map((segment) => ({
+      id: segment.id,
+      tenantId: segment.tenantId,
+      entityType: 'lead',
+      name: segment.name,
+      description: segment.description,
+      filters: this.mapSegmentFilters(segment),
+      lastMatchedCount: segment.lastMatchedCount ?? 0,
+      lastRunAt: segment.lastRunAt ? segment.lastRunAt.toISOString() : null,
+      createdAt: segment.createdAt.toISOString(),
+      updatedAt: segment.updatedAt.toISOString(),
+    }));
+  }
+
+  async createSegment(
+    tenantId: string,
+    payload: CreateSegmentRequestDto,
+  ): Promise<any> {
+    const segmentName = payload.name?.trim();
+    if (!segmentName) {
+      throw new BadRequestException('Segment name is required');
+    }
+    const filters = payload.filters ?? {};
+    const entity = this.segmentRepo.create({
+      tenantId,
+      name: segmentName,
+      description: payload.description?.trim() || null,
+      leadStatuses:
+        Array.isArray(filters.statuses) && filters.statuses.length
+          ? filters.statuses.filter(Boolean)
+          : null,
+      source:
+        Array.isArray(filters.sources) && filters.sources.length
+          ? (filters.sources[0] || null)
+          : null,
+      country:
+        Array.isArray(filters.countries) && filters.countries.length
+          ? (filters.countries[0] || null)
+          : null,
+      manager:
+        Array.isArray(filters.managers) && filters.managers.length
+          ? (filters.managers[0] || null)
+          : null,
+      createdFrom: filters.createdFrom || null,
+      createdTo: filters.createdTo || null,
+      lastMatchedCount: 0,
+      lastRunAt: null,
+    });
+
+    const saved = await this.segmentRepo.save(entity);
+    return {
+      id: saved.id,
+      tenantId: saved.tenantId,
+      entityType: 'lead',
+      name: saved.name,
+      description: saved.description,
+      filters: this.mapSegmentFilters(saved),
+      lastMatchedCount: saved.lastMatchedCount ?? 0,
+      lastRunAt: null,
+      createdAt: saved.createdAt.toISOString(),
+      updatedAt: saved.updatedAt.toISOString(),
+    };
+  }
+
+  async runSegment(tenantId: string, id: string): Promise<any[]> {
+    const segment = await this.segmentRepo.findOne({ where: { id, tenantId } });
+    if (!segment) {
+      throw new NotFoundException('Segment not found');
+    }
+
+    const qb = this.leadRepo
+      .createQueryBuilder('lead')
+      .where('lead.tenantId = :tenantId', { tenantId });
+
+    if (segment.leadStatuses?.length) {
+      qb.andWhere('lead.status IN (:...statuses)', {
+        statuses: segment.leadStatuses,
+      });
+    }
+    if (segment.source) {
+      qb.andWhere('lead.source = :source', { source: segment.source });
+    }
+    if (segment.country) {
+      qb.andWhere('lead.country = :country', { country: segment.country });
+    }
+    if (segment.manager) {
+      qb.andWhere('lead.assignedTo = :manager', { manager: segment.manager });
+    }
+    if (segment.createdFrom) {
+      qb.andWhere('lead.createdAt >= :createdFrom', {
+        createdFrom: new Date(`${segment.createdFrom}T00:00:00.000Z`),
+      });
+    }
+    if (segment.createdTo) {
+      qb.andWhere('lead.createdAt <= :createdTo', {
+        createdTo: new Date(`${segment.createdTo}T23:59:59.999Z`),
+      });
+    }
+
+    const leads = await qb
+      .orderBy('lead.createdAt', 'DESC')
+      .limit(1000)
+      .getMany();
+
+    segment.lastMatchedCount = leads.length;
+    segment.lastRunAt = new Date();
+    await this.segmentRepo.save(segment);
+
+    return leads.map((lead) => ({
+      id: lead.id,
+      name: lead.name,
+      email: lead.email,
+      phone: lead.phone,
+      status: lead.status,
+      source: lead.source,
+      country: lead.country,
+      manager: lead.assignedTo,
+      createdAt:
+        lead.createdAt instanceof Date
+          ? lead.createdAt.toISOString()
+          : new Date((lead as any).createdAt).toISOString(),
+    }));
   }
 }
